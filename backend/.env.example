# Copy to .env for local development. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://fikso:fikso@localhost:5432/fikso_dev
# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-secret-value-000000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Local HTTP only; must stay true in staging/production.
COOKIE_SECURE=false
# JSON list; empty when the frontend is served through the Vite proxy.
CORS_ORIGINS=[]
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
# SMS sign-in codes per client IP and window (each one costs an SMS).
RATE_LIMIT_SMS_CODE=3
RATE_LIMIT_UPLOAD=10
LOG_LEVEL=INFO
# Catalogue W-ID authority (R-CAT-16): issuer = production only; receiver = staging; isolated = local/test.
CATALOGUE_ROLE=isolated
# Ed25519 package signing (R-CAT-17). Generate with: python -m app.cli generate-signing-key
# Production only (secret, keep in the secret store, never on staging):
# CATALOGUE_SIGNING_PRIVATE_KEY=
# CATALOGUE_SIGNING_KEY_ID=prod-2026-11
# Staging only: JSON map of trusted public keys; several entries allow rotation.
# CATALOGUE_TRUSTED_PUBLIC_KEYS={"prod-2026-11": "<base64 public key>"}
# Staging: retired key IDs whose packages are always refused.
# CATALOGUE_REVOKED_KEY_IDS=[]
# Private evidence files (local dev/test storage); never inside a directory served over HTTP.
STORAGE_LOCAL_DIR=var/uploads
# Expiry warnings in the UI start this many days before a qualification's valid_until (Q-29).
QUALIFICATION_EXPIRY_WARNING_DAYS=30
# Processed public catalogue images (Stage C3); a different directory from private files.
STORAGE_PUBLIC_DIR=var/public-media
# Public catalogue cache in seconds (OQ-2).
PUBLIC_CACHE_SECONDS=60
# Rate limits per client IP and window (public catalogue, request creation, master location updates).
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_LOCATION=6
# --- Production (ENVIRONMENT=production refuses to start without these; see `python -m app.cli check-config`)
# APP_ORIGIN=https://app.fiksoapp.eu          # public origin; cross-site POSTs to /auth are refused
# COOKIE_SECURE=true
# CORS_ORIGINS=[]                              # same-origin deployment needs none
# RATE_LIMIT_BACKEND=postgres                  # shared by all API processes (memory = one process only)
# TRUSTED_PROXIES=["10.0.0.0/8"]               # load balancer/proxy CIDRs whose X-Forwarded-For is believed
#   Only your own proxies (the `web` container and the load balancer), as narrow as possible: a range that also
#   contains a client-facing address (e.g. the Docker gateway inside 172.16.0.0/12) lets clients spoof their IP
#   and bypass the per-IP rate limits.
# RATE_LIMIT_REQUEST_PHOTO=15
# File storage: two separate S3-compatible buckets (private files never in the public one)
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com   # omit for AWS
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PRIVATE_BUCKET=fikso-private
# S3_PUBLIC_BUCKET=fikso-public
# S3_SERVER_SIDE_ENCRYPTION=true
# Maps (Q-02): GEOCODER=google and/or MAPS_PROVIDER=google|osrm; without them ETA uses 30 km/h straight line
# GEOCODER=google
# MAPS_PROVIDER=google
# GOOGLE_MAPS_API_KEY=...                      # Geocoding API + Routes API enabled, restricted to them
# OSRM_BASE_URL=https://osrm.internal          # MAPS_PROVIDER=osrm (self-hosted)
# PROVIDER_TIMEOUT_SECONDS=4
# SMS (Q-08): only Messente is implemented; without it no SMS is queued
# SMS_PROVIDER=messente
# MESSENTE_API_USERNAME=...
# MESSENTE_API_PASSWORD=...
# SMS_SENDER=FIKSO                             # registered alphanumeric sender
# SMS_WEBHOOK_TOKEN=...                        # long random string; DLR URL = APP_ORIGIN/api/v1/webhooks/sms/messente?token=...
# Local defaults: GEOCODER unset = development stub (refused in production); no maps or SMS provider.
MAPS_PROVIDER=none
SMS_PROVIDER=none
